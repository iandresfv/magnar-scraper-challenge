# El entorno DENTRO del contenedor.
#
# El perfil `app` de docker-compose.yml ya trae estos valores como defaults, así que para
# `npm run up:full` o `npm run scale` no hace falta copiar nada. Este archivo es para ejecutar la
# imagen suelta, sin compose:
#
#   cp .env.docker.example .env.docker
#   docker run --rm --env-file .env.docker --network juris-scraper_default juris-scraper-worker
#
# La diferencia con .env.example es sólo de red: aquí los hostnames son los nombres de servicio
# de compose (`db`, `blob`, `fake`), no `localhost`, porque el contenedor no comparte la red de
# la máquina anfitriona.

DB_DRIVER=pg
DATABASE_URL=postgres://juris:juris@db:5432/juris
DB_AUTO_MIGRATE=true

BLOB_DRIVER=s3
S3_ENDPOINT=http://blob:9000
S3_BUCKET=juris
S3_REGION=us-east-1
S3_ACCESS_KEY=juris
S3_SECRET_KEY=jurisjuris
S3_FORCE_PATH_STYLE=true

# Por defecto el tribunal falso, que es lo que el perfil `app` levanta al lado. Para rastrear el
# tribunal real: SITE=br-trf5 y SITE_BASE_URL vacío (el adaptador trae la suya).
SITE=fake-pje
SITE_BASE_URL=http://fake:8080
ROLE=worker
ROOT_START=2024-01-01
ROOT_END=2024-02-29
PDF_BUDGET=0
LOG_LEVEL=info

CONCURRENCY=4
CONCURRENCY_MAX=8
CONCURRENCY_MIN=1
RATE_PER_SEC=2
BURST=4

LEASE_MS=90000
IDLE_POLL_MS=500

# El healthcheck de la imagen prueba /healthz cuando esta variable está puesta.
METRICS_PORT=9464
