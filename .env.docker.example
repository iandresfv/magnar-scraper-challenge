# Configuración del camino CON Docker (`npm run up` / perfil `app`).
# Copiar a `.env.docker`. Los hostnames son los nombres de servicio de compose.

DB_DRIVER=pg
DATABASE_URL=postgres://juris:juris@db:5432/juris
DB_AUTO_MIGRATE=true

BLOB_DRIVER=s3
S3_ENDPOINT=http://blob:9000
S3_BUCKET=juris
S3_REGION=us-east-1
S3_ACCESS_KEY=juris
S3_SECRET_KEY=jurisjuris
S3_FORCE_PATH_STYLE=true

SITE=br-trf5
ROOT_START=1990-01-01
PDF_BUDGET=150
LOG_LEVEL=info

CONCURRENCY=4
CONCURRENCY_MAX=8
CONCURRENCY_MIN=1
RATE_PER_SEC=2

# Credenciales del compose. Cambiarlas aquí las cambia también en los servicios.
POSTGRES_USER=juris
POSTGRES_PASSWORD=juris
POSTGRES_DB=juris
