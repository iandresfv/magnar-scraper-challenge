# Configuración del camino SIN Docker (`npm start`).
# Copiar a `.env` y ajustar. `node --env-file=.env` lo carga; nunca se commitea.

# ── Base de datos ───────────────────────────────────────────────────────────────
# DB_DRIVER=pg usa DATABASE_URL; DB_DRIVER=pglite usa DB_PATH (Postgres embebido, sin Docker).
# Si se deja vacío, el arranque prueba DATABASE_URL y cae a pglite con un aviso de una línea.
DB_DRIVER=
DATABASE_URL=postgres://juris:juris@localhost:55432/juris
DB_PATH=./data/pg
DB_AUTO_MIGRATE=true

# ── Object storage ──────────────────────────────────────────────────────────────
# BLOB_DRIVER=s3 habla el API S3 (RustFS local, AWS S3, GCS por interop HMAC, Garage…).
# BLOB_DRIVER=fs escribe en disco. Vacío = autodetección con fallback a fs.
BLOB_DRIVER=
BLOB_DIR=./data/blobs
S3_ENDPOINT=http://localhost:59000
S3_BUCKET=juris
S3_REGION=us-east-1
S3_ACCESS_KEY=juris
S3_SECRET_KEY=jurisjuris
S3_FORCE_PATH_STYLE=true

# Los puertos publicados por compose son 55432 (Postgres) y 59000/59001 (S3 + consola), no los
# estándar: un 5432 o un 9000 libres en la máquina de quien evalúa son la excepción. Se cambian
# con POSTGRES_PORT / S3_PORT / S3_CONSOLE_PORT en el entorno de compose.

# ── Crawl ───────────────────────────────────────────────────────────────────────
SITE=br-trf5
ROLE=all
ROOT_START=1990-01-01
PDF_BUDGET=150
LOG_LEVEL=info

# ── Cortesía con el servidor público (v1 §5.2) ──────────────────────────────────
CONCURRENCY=4
CONCURRENCY_MAX=8
CONCURRENCY_MIN=1
RATE_PER_SEC=2
