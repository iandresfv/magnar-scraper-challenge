# Configuración del camino SIN Docker (`npm start`), y a la vez las variables que `docker compose`
# interpola al levantar la infraestructura.
#
#   cp .env.example .env
#
# `node --env-file=.env` la carga en el proceso, y compose lee el mismo archivo para resolver los
# `${...}` de docker-compose.yml. Nunca se commitea: está en .gitignore desde el primer commit.
# Todo lo que aparece aquí tiene un valor por defecto en el código; este archivo existe para
# cambiarlos, no para que el programa arranque.

# ── Base de datos ───────────────────────────────────────────────────────────────
# DB_DRIVER=pg usa DATABASE_URL; DB_DRIVER=pglite usa DB_PATH (Postgres embebido, sin Docker).
# Vacío = autodetección: prueba DATABASE_URL y cae a pglite con un aviso de una línea.
DB_DRIVER=
DATABASE_URL=postgres://juris:juris@localhost:55432/juris
DB_PATH=./data/pg
# false en un despliegue real, donde migrar es un paso previo y no un efecto de arrancar.
DB_AUTO_MIGRATE=true

# ── Object storage ──────────────────────────────────────────────────────────────
# BLOB_DRIVER=s3 habla el API S3 (RustFS local, AWS S3, GCS por interop HMAC, Garage…).
# BLOB_DRIVER=fs escribe en disco. Vacío = autodetección con fallback a fs.
BLOB_DRIVER=
BLOB_DIR=./data/blobs
S3_ENDPOINT=http://localhost:59000
S3_BUCKET=juris
S3_REGION=us-east-1
S3_ACCESS_KEY=juris
S3_SECRET_KEY=jurisjuris
# true mientras el endpoint sea RustFS o MinIO; AWS S3 real prefiere false (virtual-host style).
S3_FORCE_PATH_STYLE=true

# ── Qué se rastrea ──────────────────────────────────────────────────────────────
SITE=br-trf5
# Sólo para sitios que no traen su URL fija: el tribunal falso de los tests la necesita.
SITE_BASE_URL=
ROLE=all
ROOT_START=1990-01-01
# Vacío = hoy + 1 año, que es hasta donde el sitio acepta fechas de autuação.
ROOT_END=
# Cuántos PDF puede descargar ESTA corrida. `all` levanta el límite; 0 no descarga ninguno.
PDF_BUDGET=150
# Enmascara CPF/CNPJ en los reportes. `report` ya lo hace por defecto.
ANONYMIZE=false
LOG_LEVEL=info

# ── Cortesía con el servidor público (v1 §5.2) ──────────────────────────────────
# El arranque es 4 y el techo 8 por decisión explícita: el tribunal es un servicio público y
# nadie autorizó una prueba de carga. La ley de control (AIMD) sube de a uno y baja a la mitad.
CONCURRENCY=4
CONCURRENCY_MAX=8
CONCURRENCY_MIN=1
RATE_PER_SEC=2
BURST=4

# ── Cola ────────────────────────────────────────────────────────────────────────
# Cuánto tiempo un worker retiene un job antes de que otro pueda robarlo (muerte del proceso).
LEASE_MS=90000
# Cuánto espera un worker ocioso antes de volver a mirar la cola.
IDLE_POLL_MS=500
# Vacío = hostname + pid, que es lo que hace legible `juris.job.leased_by`.
WORKER_ID=

# ── Observabilidad ──────────────────────────────────────────────────────────────
# Vacío = sin endpoint. Con valor, expone /metrics (texto Prometheus) y /healthz.
METRICS_PORT=

# ── Sólo para docker compose ────────────────────────────────────────────────────
# Puertos publicados en la máquina anfitriona. No son los estándar a propósito: un 5432 o un
# 9000 libres en la máquina de quien evalúa son la excepción, y el fallo de compose es opaco.
POSTGRES_PORT=55432
S3_PORT=59000
S3_CONSOLE_PORT=59001
POSTGRES_USER=juris
POSTGRES_PASSWORD=juris
POSTGRES_DB=juris
# El tribunal falso del perfil `app`: puerto publicado y cuántos días de datos sintéticos genera.
FAKE_PORT=58080
FAKE_DAYS=120
# Cuántos workers levanta `npm run scale`.
WORKERS=3
